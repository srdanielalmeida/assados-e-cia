# ─── Ambiente ─────────────────────────────────────────────────
# Credenciais do aplicativo no Portal do Parceiro iFood
IFOOD_CLIENT_ID=your_client_id_here
IFOOD_CLIENT_SECRET=your_client_secret_here

# Merchant ID do estabelecimento (já presente em js/app.js)
IFOOD_MERCHANT_ID=433624d2-a0a2-433a-a443-9cc124c240bf

# Porta do servidor backend (o frontend fica em 8000)
PORT=3001

# PIN simples para proteger as rotas administrativas do painel
ADMIN_PIN=1234

# Ambiente: development | production
NODE_ENV=development
